# Environment variables the harness reads — names only, never values.
# Copy to .env.local (gitignored) and export before running, e.g.
#   set -a; source .env.local; set +a

# --- Anthropic (default provider) ------------------------------------------
ANTHROPIC_API_KEY=
# Gateway token accepted in place of the API key.
ANTHROPIC_AUTH_TOKEN=
# Override the Anthropic API host (a gateway). Read by the SDK.
ANTHROPIC_BASE_URL=

# --- AWS Bedrock (only for --provider bedrock) -----------------------------
# Any standard AWS credential source works (env keys, profile, SSO, role).
AWS_REGION=
AWS_PROFILE=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# --- SpreadsheetBench 2 dataset location (default data/spreadsheetbench-v2) -
SPREADSHEETBENCH_DIR=
